#!/bin/zsh
# claude-agent: role-aware, hang-proof dispatcher over the flat-sub wrappers
# (claude-sol / claude-kimi / claude-minimax).
#
# Usage: claude-agent [--degrade] [--no-isolate] [--include-dirty]
#                     [--brief FILE] [--allowed-paths GLOBS] [--run-dir DIR]
#                     <role> [claude args...]
#        claude-agent runs show <run-id>
#        claude-agent runs mark <run-id> integrated|abandoned
#        claude-agent runs prune|gc [--dry-run] [--auto]
#
# Exit: 0 required worker delivered | 3 PRIMARY_UNAVAILABLE (orchestrator re-plans) |
#       4 TASK_FAILED (worker ran, but the task itself failed; no fallback) |
#       10 degraded result (provisional; verify+disclose) | 2 usage error
emulate -L zsh
setopt pipe_fail

PROBE_TIMEOUT=${AGENT_PROBE_TIMEOUT:-120}
PROBE_RETRIES=${AGENT_PROBE_RETRIES:-3}
PROBE_BACKOFF=${AGENT_PROBE_BACKOFF:-2}
PROBE_CACHE_TTL=${AGENT_PROBE_CACHE_TTL:-600}
TASK_TIMEOUT=${AGENT_TIMEOUT:-5400}
HEARTBEAT_INTERVAL=${AGENT_HEARTBEAT_INTERVAL:-60}
DIFFSTAT_INTERVAL=${AGENT_DIFFSTAT_INTERVAL:-600}
AGENT_BIN_DIR=${AGENT_BIN_DIR:-$HOME/.local/bin}
STATE_ROOT=${WORKJET_STATE_DIR:-$HOME/.local/state/workjet}
OPUS_TOKEN_FILE=${OPUS_TOKEN_FILE:-$HOME/.config/secrets/claude-oauth}
CLIPROXY_TOKEN_FILE=${CLIPROXY_TOKEN_FILE:-}
CLIPROXY_RESTART_DELAY=${CLIPROXY_RESTART_DELAY:-3}

load_visible_prompt_block() {
  local begin_marker="$1" end_marker="$2" label="$3"
  local prompt_file="$HOME/.claude/workjet/AGENTS.md" prompt
  if [[ ! -r "$prompt_file" ]]; then
    print -u2 "[claude-agent] visible $label unavailable: $prompt_file"
    return 2
  fi
  prompt="$(sed -n "/^${begin_marker}$/,/^${end_marker}$/p" "$prompt_file" | sed '1d;$d')"
  if [[ -z "$prompt" ]]; then
    print -u2 "[claude-agent] visible $label is missing from Workjet technical rules"
    return 2
  fi
  print -r -- "$prompt"
}

load_health_probe_prompt() {
  local checkout="${1:-${PWD:A}}"
  local prompt
  prompt="$(load_visible_prompt_block '<!-- WORKJET HEALTH PROBE PROMPT BEGIN -->' '<!-- WORKJET HEALTH PROBE PROMPT END -->' 'health probe prompt')" || return 2
  print -r -- "${prompt//<WORKJET_CHECKOUT>/$checkout}"
}

run_doctor() {
  local probe_prompt worker of ef pid watchdog rc out err health_state detail failures=0
  local attempt max_attempts delay
  local cache_tmp="$STATE_ROOT/.doctor.$$"
  mkdir -p "$STATE_ROOT"
  probe_prompt="$(load_health_probe_prompt "${PWD:A}")" || return 2
  print "WORKER\tSTATUS\tDETAIL"
  : > "$cache_tmp"
  for worker in claude-sol claude-kimi claude-minimax; do
    of="$(mktemp)"; ef="$(mktemp)"
    if [[ ! -x "$AGENT_BIN_DIR/$worker" ]]; then
      rc=127
      print -r -- "worker executable missing: $AGENT_BIN_DIR/$worker" > "$ef"
    else
      attempt=0
      max_attempts=$(( PROBE_RETRIES + 1 ))
      (( max_attempts > 0 )) || max_attempts=1
      while (( attempt < max_attempts )); do
        (( ++attempt ))
        : > "$of"; : > "$ef"
        if (( $+commands[setsid] )); then
          setsid "$AGENT_BIN_DIR/$worker" -p "$probe_prompt" </dev/null >"$of" 2>"$ef" &
        else
          python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
            "$AGENT_BIN_DIR/$worker" -p "$probe_prompt" </dev/null >"$of" 2>"$ef" &
        fi
        pid=$!
        (
          sleep "$PROBE_TIMEOUT"
          if kill -0 "$pid" 2>/dev/null; then
            kill -TERM -- -"$pid" 2>/dev/null
            sleep 1
            kill -KILL -- -"$pid" 2>/dev/null
          fi
        ) &
        watchdog=$!
        wait "$pid" 2>/dev/null; rc=$?
        kill "$watchdog" 2>/dev/null; wait "$watchdog" 2>/dev/null
        out="$(<"$of")"
        if (( rc == 0 )) && [[ -n "${out//[[:space:]]/}" ]]; then
          break
        fi
        if (( attempt < max_attempts )); then
          delay=$(( PROBE_BACKOFF * attempt ))
          (( delay > 0 )) && sleep "$delay"
        fi
      done
    fi
    out="$(<"$of")"; err="$(<"$ef")"
    rm -f "$of" "$ef"
    if (( rc == 0 )) && [[ -n "${out//[[:space:]]/}" ]]; then
      health_state=OK; detail=probe
    else
      health_state=DEAD
      detail="${${err//$'\n'/ }[1,160]}"
      [[ -n "$detail" ]] || detail="probe failed (rc=$rc)"
      (( ++failures ))
    fi
    printf '%s\t%s\t%s\n' "$worker" "$health_state" "$detail"
    printf '%s\t%s\t%s\n' "$worker" "$health_state" "$detail" >> "$cache_tmp"
  done
  if [[ -f "$OPUS_TOKEN_FILE" && -r "$OPUS_TOKEN_FILE" && -s "$OPUS_TOKEN_FILE" ]]; then
    health_state=OK; detail="token present: $OPUS_TOKEN_FILE"
  else
    health_state=DEAD; detail="token missing or empty: $OPUS_TOKEN_FILE"
    (( ++failures ))
  fi
  printf '%s\t%s\t%s\n' claude-opus "$health_state" "$detail"
  printf '%s\t%s\t%s\n' claude-opus "$health_state" "$detail" >> "$cache_tmp"
  mv "$cache_tmp" "$STATE_ROOT/doctor.tsv"
  (( failures == 0 ))
}

if [[ "$1" == doctor ]]; then
  [[ $# -eq 1 ]] || { print -u2 "use: claude-agent doctor"; exit 2; }
  run_doctor
  exit $?
fi

accept_run() {
  local run_id="$1" index_file run_dir repo_root protected_ref before_head after_head
  local merge_state=FAIL checks_state=SKIP checks_detail=SKIP whitelist_state=FAIL result=FAILED checks_rc=0
  local whitelist_file violations_file changed_file report_file pattern changed
  local -a whitelist changed_paths violations

  [[ -n "$run_id" && "$run_id" != */* && "$run_id" != .* ]] || {
    print -u2 "claude-agent: invalid run id '${run_id:-}'"
    return 2
  }
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    print -u2 "claude-agent: accept must run inside the target Git repository"
    return 2
  }
  repo_root="${repo_root:A}"
  index_file="$STATE_ROOT/run-index/$run_id"
  if [[ -f "$index_file" ]]; then
    run_dir="$(<"$index_file")"
  else
    run_dir="$STATE_ROOT/runs/$run_id"
  fi
  [[ -d "$run_dir" && -s "$run_dir/brief.txt" && -s "$run_dir/protected-ref" ]] || {
    print -u2 "claude-agent: incomplete run journal for '$run_id': $run_dir"
    return 2
  }
  if [[ -n "$(git -C "$repo_root" status --porcelain --untracked-files=all)" ]]; then
    print -u2 "claude-agent: accept requires a clean current checkout"
    return 4
  fi
  protected_ref="$(<"$run_dir/protected-ref")"
  [[ "$protected_ref" == refs/workjet/* ]] && git -C "$repo_root" rev-parse --verify -q "$protected_ref^{commit}" >/dev/null || {
    print -u2 "claude-agent: protected ref is missing or invalid: $protected_ref"
    return 4
  }

  whitelist_file="$run_dir/accept-whitelist.txt"
  violations_file="$run_dir/accept-whitelist-violations.txt"
  changed_file="$run_dir/accept-changed-files.txt"
  report_file="$run_dir/accept-report.txt"
  python3 - "$run_dir/brief.txt" > "${whitelist_file}.tmp" <<'PY'
import re
import sys

lines = open(sys.argv[1], encoding="utf-8").read().splitlines()
entries = []
collecting = False
for line in lines:
    marker = re.match(r"^\s*(?:#{1,6}\s*)?FILE WHITELIST\s*:?\s*(.*)$", line, re.I)
    if marker:
        collecting = True
        if marker.group(1).strip():
            entries.append(marker.group(1).strip())
        continue
    if not collecting:
        continue
    stripped = line.strip()
    if not stripped:
        if entries:
            break
        continue
    if re.match(r"^#{1,6}\s+", stripped) or re.match(
        r"^(?:HARD RULES|ACCEPTANCE|REPORT TAIL|OUTPUT|TESTS|OPEN|COMMIT)\b", stripped, re.I
    ):
        break
    entries.append(stripped)

for entry in entries:
    entry = re.sub(r"^[-*+]\s*", "", entry).strip()
    entry = re.sub(r"^ONLY\s+", "", entry, flags=re.I)
    entry = re.split(r"\bFORBIDDEN\s*:", entry, maxsplit=1, flags=re.I)[0]
    entry = entry.strip().rstrip(".")
    for item in entry.split(","):
        item = item.strip().strip("`'\"")
        if item:
            print(item)
PY
  if [[ $? -ne 0 ]]; then
    rm -f "${whitelist_file}.tmp"
  else
    mv "${whitelist_file}.tmp" "$whitelist_file"
  fi
  [[ -s "$whitelist_file" ]] && whitelist=("${(@f)$(<"$whitelist_file")}")

  before_head="$(git -C "$repo_root" rev-parse HEAD)" || return 4
  if git -C "$repo_root" merge --no-edit "$protected_ref" > "$run_dir/accept-merge.out" 2> "$run_dir/accept-merge.err"; then
    merge_state=PASS
  else
    git -C "$repo_root" merge --abort >/dev/null 2>&1 || true
  fi

  if [[ "$merge_state" == PASS ]]; then
    after_head="$(git -C "$repo_root" rev-parse HEAD)"
    git -C "$repo_root" diff --name-only "$before_head..$after_head" -- > "$changed_file"
    changed_paths=("${(@f)$(<"$changed_file")}")

    if [[ -x "$repo_root/.workjet/checks.sh" ]]; then
      (cd "$repo_root" && ./.workjet/checks.sh) > "$run_dir/accept-checks.out" 2> "$run_dir/accept-checks.err"
      checks_rc=$?
      (( checks_rc == 0 )) && checks_state=PASS || checks_state=FAIL
    elif [[ -f "$repo_root/.workjet/checks.sh" ]]; then
      (cd "$repo_root" && /bin/sh .workjet/checks.sh) > "$run_dir/accept-checks.out" 2> "$run_dir/accept-checks.err"
      checks_rc=$?
      (( checks_rc == 0 )) && checks_state=PASS || checks_state=FAIL
    fi

    : > "$violations_file"
    if (( ${#whitelist} )); then
      for changed in "${changed_paths[@]}"; do
        local allowed=0
        for pattern in "${whitelist[@]}"; do
          [[ "$pattern" == */ ]] && pattern+="**"
          if [[ "$changed" == ${~pattern} ]]; then
            allowed=1
            break
          fi
        done
        (( allowed )) || { print -r -- "$changed" >> "$violations_file"; violations+=("$changed"); }
      done
      (( ${#violations} == 0 )) && whitelist_state=PASS
    else
      print -r -- "<missing FILE WHITELIST block>" > "$violations_file"
    fi
  fi

  if [[ "$merge_state" == PASS && "$checks_state" != FAIL && "$whitelist_state" == PASS ]]; then
    result=ACCEPTED
    rm -f "$run_dir/abandoned"
    : > "$run_dir/integrated"
  fi
  checks_detail="$checks_state"
  [[ "$checks_state" == FAIL ]] && checks_detail="FAIL (rc=$checks_rc)"
  {
    print "ACCEPTANCE REPORT"
    print -r -- "RUN-ID: $run_id"
    print -r -- "RUN-DIR: $run_dir"
    print -r -- "PROTECTED-REF: $protected_ref"
    print -r -- "MERGE: $merge_state"
    print -r -- "CHECKS: $checks_detail"
    print -r -- "WHITELIST: $whitelist_state"
    print -r -- "CHANGED-FILES: ${#changed_paths}"
    for changed in "${changed_paths[@]}"; do print -r -- "  $changed"; done
    if (( ${#violations} )); then
      print "VIOLATIONS:"
      for changed in "${violations[@]}"; do print -r -- "  $changed"; done
    elif [[ "$whitelist_state" == FAIL && ! -s "$whitelist_file" ]]; then
      print "VIOLATIONS:"
      print "  <missing FILE WHITELIST block>"
    fi
    print -r -- "RESULT: $result"
  } | tee "$report_file"
  [[ "$result" == ACCEPTED ]]
}

if [[ "$1" == accept ]]; then
  [[ $# -eq 2 ]] || { print -u2 "use: claude-agent accept <run-id>"; exit 2; }
  accept_run "$2"
  exit $?
fi

mark_run() {
  local run_id="$1" state="$2" index_file run_dir
  [[ -n "$run_id" && "$run_id" != */* && "$run_id" != .* ]] || {
    print -u2 "claude-agent: invalid run id '${run_id:-}'"
    return 2
  }
  case "$state" in
    integrated|abandoned) ;;
    *) print -u2 "claude-agent: mark must be integrated or abandoned"; return 2 ;;
  esac
  index_file="$STATE_ROOT/run-index/$run_id"
  if [[ -f "$index_file" ]]; then
    run_dir="$(<"$index_file")"
  else
    run_dir="$STATE_ROOT/runs/$run_id"
  fi
  [[ -d "$run_dir" ]] || {
    print -u2 "claude-agent: run directory not found for '$run_id': $run_dir"
    return 2
  }
  rm -f "$run_dir/integrated" "$run_dir/abandoned" "$run_dir/pruned"
  : > "$run_dir/$state"
  print -r -- "[claude-agent] marked run $run_id $state: $run_dir"
}

run_dir_for_id() {
  local id="$1" index_file="$STATE_ROOT/run-index/$id"
  if [[ -f "$index_file" ]]; then
    print -r -- "$(<"$index_file")"
  else
    print -r -- "$STATE_ROOT/runs/$id"
  fi
}

show_run() {
  local run_id="$1"
  python3 - "$STATE_ROOT" "$run_id" <<'PY'
import json
import os
import re
import stat
import sys

state_root, run_id = sys.argv[1:]


def fail(message):
    print(f"claude-agent: {message}", file=sys.stderr)
    raise SystemExit(2)


def clean(value, limit=240):
    if not isinstance(value, str):
        return "<none>"
    value = "".join(ch if ch >= " " and ch != "\x7f" else " " for ch in value)
    value = " ".join(value.split())
    return value[:limit] if value else "<none>"


if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", run_id) or ".." in run_id:
    fail(f"invalid run id {run_id!r}")

runs_root = os.path.realpath(os.path.join(state_root, "runs"))
index_path = os.path.join(state_root, "run-index", run_id)
if os.path.lexists(index_path):
    try:
        info = os.lstat(index_path)
    except OSError:
        fail("run index cannot be inspected")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or info.st_size > 4096:
        fail("run index is not a trusted regular file")
    try:
        raw_target = open(index_path, encoding="utf-8").read()
    except (OSError, UnicodeError):
        fail("run index cannot be read safely")
    if not raw_target or raw_target.count("\n") > 1 or "\x00" in raw_target:
        fail("run index contains an invalid path")
    target = raw_target.rstrip("\n")
    if not os.path.isabs(target) or any(ord(ch) < 32 for ch in target):
        fail("run index contains an invalid path")
else:
    target = os.path.join(runs_root, run_id)

run_dir = os.path.realpath(target)
try:
    if os.path.commonpath([runs_root, run_dir]) != runs_root:
        fail("run directory is outside the trusted runs root")
except ValueError:
    fail("run directory is outside the trusted runs root")
if run_dir == runs_root or not os.path.isdir(run_dir) or os.path.islink(target):
    fail("trusted run directory was not found")

completion_path = os.path.join(run_dir, "completion.json")
try:
    info = os.lstat(completion_path)
except OSError:
    fail("completion.json was not found")
if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or info.st_size > 262144:
    fail("completion.json is not a trusted bounded regular file")
try:
    with open(completion_path, encoding="utf-8") as handle:
        completion = json.load(handle)
except (OSError, UnicodeError, json.JSONDecodeError):
    fail("completion.json is invalid")

if not isinstance(completion, dict) or completion.get("schemaVersion") != 1:
    fail("completion.json has an unsupported schema")
receipt = completion.get("receipt")
claims = completion.get("claims")
observations = completion.get("observations")
if not isinstance(receipt, dict) or not isinstance(observations, dict):
    fail("completion.json is missing receipt observations")
if observations.get("runId") != run_id:
    fail("completion.json run id does not match the requested run")
health = receipt.get("status")
if health not in {"valid", "missing", "invalid"}:
    fail("completion.json has an invalid receipt status")
terminal = observations.get("terminal")
flags = observations.get("flags")
path_violation = observations.get("pathViolation")
if not isinstance(terminal, dict) or not isinstance(flags, dict) or not isinstance(path_violation, dict):
    fail("completion.json has invalid dispatcher observations")

print(f"RUN {clean(run_id, 128)}")
print(f"role: {clean(observations.get('role'), 64)}")
print(f"workers: required={clean(observations.get('requiredWorker'), 64)} actual={clean(observations.get('actualWorker'), 64)}")
print(f"terminal: exit={terminal.get('exitCode', '<invalid>')} classification={clean(terminal.get('classification'), 64)}")
print(f"receipt: {health}")
if health == "valid" and isinstance(claims, dict):
    print(f"claim: status={clean(claims.get('status'), 32)} summary={clean(claims.get('summary'), 320)}")
    print(
        "claim-counts: changedFiles={} verification={} concerns={} producedPaths={}".format(
            len(claims.get("changedFiles", [])) if isinstance(claims.get("changedFiles"), list) else "?",
            len(claims.get("verification", [])) if isinstance(claims.get("verification"), list) else "?",
            len(claims.get("concerns", [])) if isinstance(claims.get("concerns"), list) else "?",
            len(claims.get("producedPaths", [])) if isinstance(claims.get("producedPaths"), list) else "?",
        )
    )
print(
    "observed: timeout={} tamper={} pathViolation={}".format(
        str(bool(flags.get("timeout"))).lower(),
        str(bool(flags.get("tamper"))).lower(),
        clean(path_violation.get("state"), 32),
    )
)
protected = observations.get("protectedResult")
if isinstance(protected, dict):
    print(f"protected: ref={clean(protected.get('ref'), 200)} sha={clean(protected.get('sha'), 80)}")
worktree = observations.get("worktree")
if isinstance(worktree, dict):
    print(f"worktree: {clean(worktree.get('path'), 400)}")
diffstat = observations.get("diffstat")
if isinstance(diffstat, str) and diffstat:
    lines = [clean(line, 240) for line in diffstat.splitlines()[:8]]
    print("diffstat:")
    for line in lines:
        print(f"  {line}")

artifacts = []
for name in ("completion.json", "stdout", "stderr", "diffstat", "protected-ref", "timeout.diffstat", "path-violations.txt"):
    path = os.path.join(run_dir, name)
    try:
        item = os.lstat(path)
    except OSError:
        continue
    if stat.S_ISREG(item.st_mode) and not stat.S_ISLNK(item.st_mode):
        artifacts.append(name)
print(f"artifacts: {', '.join(artifacts)}")
print(f"run-directory: {clean(run_dir, 600)}")
PY
}

prune_worktrees() {
  local dry_run="${1:-0}" scope="${2:-$STATE_ROOT/worktrees}" old_only="${3:-0}" allow_unmarked="${4:-0}"
  local worktrees_root root_abs scope_abs candidate candidate_abs id run_dir recorded_path recorded_abs
  local marker state pid_file pid common_dir common_abs worktree_status expected_ref
  local was_unmarked
  local scanned=0 pruned=0 retained=0
  local -a find_depth find_age

  worktrees_root="$STATE_ROOT/worktrees"
  [[ -d "$worktrees_root" ]] || {
    print "[claude-agent] worktree prune summary: scanned=0 pruned=0 retained=0"
    return 0
  }
  root_abs="${worktrees_root:A}"
  [[ -d "$scope" ]] || {
    print "[claude-agent] worktree prune summary: scanned=0 pruned=0 retained=0"
    return 0
  }
  scope_abs="${scope:A}"
  if [[ "$scope_abs" == "$root_abs" ]]; then
    find_depth=(-mindepth 2 -maxdepth 2)
  elif [[ "$scope_abs" == "$root_abs/"* ]]; then
    find_depth=(-mindepth 1 -maxdepth 1)
  else
    print -u2 "claude-agent: refusing worktree prune outside state root: $scope_abs"
    return 2
  fi
  (( old_only )) && find_age=(-mtime +0)

  while IFS= read -r -d '' candidate; do
    (( ++scanned ))
    candidate_abs="${candidate:A}"
    id="${candidate_abs:t}"
    run_dir="$(run_dir_for_id "$id")"
    marker=""
    [[ -f "$run_dir/integrated" ]] && marker=integrated
    [[ -f "$run_dir/abandoned" ]] && marker=abandoned
    was_unmarked=0

    if [[ "$candidate_abs" != "$root_abs/"* ]]; then
      print "[claude-agent] retained $id: path outside worktree state root ($candidate_abs)"
      (( ++retained ))
      continue
    fi
    [[ -f "$run_dir/pruned" ]] && marker=pruned
    if [[ -z "$marker" ]] && ! (( old_only && allow_unmarked )); then
      print "[claude-agent] retained $id: run is unmarked (automatic pruning requires the 24h safety window)"
      (( ++retained ))
      continue
    fi
    if [[ -z "$marker" ]]; then
      marker=unmarked
      was_unmarked=1
    fi
    state=""
    if [[ -f "$run_dir/run-state.json" ]]; then
      state="$(sed -n 's/.*"state":"\([^"]*\)".*/\1/p' "$run_dir/run-state.json" | head -n 1)"
      if [[ "$state" != completed && "$state" != failed ]]; then
        print "[claude-agent] retained $id: run is not terminal (state=${state:-invalid})"
        (( ++retained ))
        continue
      fi
    elif [[ ! -f "$run_dir/exit" ]]; then
      print "[claude-agent] retained $id: run is not terminal (state=unknown)"
      (( ++retained ))
      continue
    fi
    if [[ ! -s "$run_dir/worktree-path" ]]; then
      print "[claude-agent] retained $id: missing worktree path metadata"
      (( ++retained ))
      continue
    fi
    recorded_path="$(<"$run_dir/worktree-path")"
    recorded_abs="${recorded_path:A}"
    if [[ "$recorded_abs" != "$candidate_abs" || "$recorded_abs" != "$root_abs/"* ]]; then
      print "[claude-agent] retained $id: worktree path metadata is outside or does not match ($recorded_path)"
      (( ++retained ))
      continue
    fi

    for pid_file in "$run_dir/pid" "$run_dir/journal-pid"; do
      [[ -e "$pid_file" ]] || continue
      pid="$(<"$pid_file")"
      if [[ "$pid" != <-> ]]; then
        print "[claude-agent] retained $id: invalid process metadata in $pid_file"
        marker=""
        break
      fi
      if kill -0 "$pid" 2>/dev/null || ps -p "$pid" -o pid= 2>/dev/null | grep -q '[0-9]'; then
        print "[claude-agent] retained $id: process $pid from ${pid_file:t} is still alive"
        marker=""
        break
      fi
    done
    if [[ -z "$marker" ]]; then
      (( ++retained ))
      continue
    fi

    expected_ref="refs/workjet/$id"
    if [[ ! -s "$run_dir/protected-ref" || "$(<"$run_dir/protected-ref")" != "$expected_ref" ]]; then
      print "[claude-agent] retained $id: missing or mismatched protected ref metadata ($expected_ref)"
      (( ++retained ))
      continue
    fi
    if ! git -C "$candidate_abs" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      print "[claude-agent] retained $id: path is not a registered Git worktree"
      (( ++retained ))
      continue
    fi
    if ! git -C "$candidate_abs" rev-parse --verify -q "$expected_ref^{commit}" >/dev/null; then
      print "[claude-agent] retained $id: protected ref is missing or not a commit ($expected_ref)"
      (( ++retained ))
      continue
    fi
    worktree_status="$(git -C "$candidate_abs" status --porcelain --untracked-files=all --ignored=matching 2>/dev/null)" || {
      print "[claude-agent] retained $id: Git status could not be read"
      (( ++retained ))
      continue
    }
    if [[ -n "$worktree_status" ]]; then
      print "[claude-agent] retained $id: worktree is dirty"
      (( ++retained ))
      continue
    fi
    common_dir="$(git -C "$candidate_abs" rev-parse --git-common-dir 2>/dev/null)" || {
      print "[claude-agent] retained $id: Git common directory could not be resolved"
      (( ++retained ))
      continue
    }
    [[ "$common_dir" == /* ]] || common_dir="$candidate_abs/$common_dir"
    common_abs="${common_dir:A}"

    if (( dry_run )); then
      if (( was_unmarked )); then
        print "[claude-agent] would prune unmarked terminal worktree: $candidate_abs"
      else
        print "[claude-agent] would prune $marker worktree: $candidate_abs"
      fi
      continue
    fi
    if (( old_only )); then
      print "[claude-agent] removing $marker worktree older than 24h: $candidate_abs"
    else
      print "[claude-agent] pruning $marker worktree: $candidate_abs"
    fi
    if git --git-dir="$common_abs" worktree remove -- "$candidate_abs" >/dev/null 2>&1; then
      if (( was_unmarked )); then
        : > "$run_dir/pruned"
        print "[claude-agent] preserved journal and protected ref; marked run $id pruned"
      fi
      (( ++pruned ))
    else
      print "[claude-agent] retained $id: git worktree remove refused the path"
      (( ++retained ))
    fi
  done < <(find "$scope_abs" "${find_depth[@]}" -type d "${find_age[@]}" -print0 2>/dev/null)

  print "[claude-agent] worktree prune summary: scanned=$scanned pruned=$pruned retained=$retained"
}

if [[ "$1" == runs ]]; then
  case "$2" in
    show)
      [[ $# -eq 3 ]] || { print -u2 "use: claude-agent runs show <run-id>"; exit 2; }
      show_run "$3"
      exit $?
      ;;
    mark)
      [[ $# -eq 4 ]] || { print -u2 "use: claude-agent runs mark <run-id> integrated|abandoned"; exit 2; }
      mark_run "$3" "$4"
      exit $?
      ;;
    prune|gc)
      prune_dry_run=0
      prune_auto=0
      shift 2
      while (( $# )); do
        case "$1" in
          --dry-run) prune_dry_run=1 ;;
          --auto) prune_auto=1 ;;
          *) print -u2 "use: claude-agent runs prune|gc [--dry-run] [--auto]"; exit 2 ;;
        esac
        shift
      done
      prune_worktrees "$prune_dry_run" "$STATE_ROOT/worktrees" "$prune_auto" "$prune_auto"
      exit $?
      ;;
    *)
      print -u2 "use: claude-agent runs show <run-id>"
      print -u2 "     claude-agent runs mark <run-id> integrated|abandoned"
      print -u2 "     claude-agent runs prune|gc [--dry-run] [--auto]"
      exit 2
      ;;
  esac
fi

allow_degrade=0
isolate=1
include_dirty=0
run_dir_override=""
allowed_paths=""
brief_file=""
while [[ "$1" == --* ]]; do
  case "$1" in
    --degrade) allow_degrade=1 ;;
    --no-isolate) isolate=0 ;;
    --include-dirty) include_dirty=1 ;;
    --brief)
      shift
      [[ -n "$1" ]] || { print -u2 "claude-agent: --brief requires a file"; exit 2; }
      brief_file="$1"
      ;;
    --brief=*) brief_file="${1#--brief=}" ;;
    --allowed-paths)
      shift
      [[ -n "$1" ]] || { print -u2 "claude-agent: --allowed-paths requires comma-separated globs"; exit 2; }
      allowed_paths="$1"
      ;;
    --allowed-paths=*) allowed_paths="${1#--allowed-paths=}" ;;
    --run-dir)
      shift
      [[ -n "$1" ]] || { print -u2 "claude-agent: --run-dir requires a directory"; exit 2; }
      run_dir_override="$1"
      ;;
    --run-dir=*) run_dir_override="${1#--run-dir=}" ;;
    *) print -u2 "claude-agent: unknown option '$1'"; exit 2 ;;
  esac
  shift
done
role="$1"; shift 2>/dev/null
case "$role" in
  hard) print -u2 "[claude-agent] deprecated role 'hard'; use 'implementation-hard'"; role=implementation-hard ;;
  normal) print -u2 "[claude-agent] deprecated role 'normal'; use 'research'"; role=research ;;
  simple) print -u2 "[claude-agent] deprecated role 'simple'; use 'bulk-generation'"; role=bulk-generation ;;
esac
case "$role" in
  implementation-hard)  chain=(claude-sol claude-kimi claude-opus) ;;
  frontend-greenfield)  chain=(claude-kimi claude-sol claude-opus) ;;
  frontend-integration) chain=(claude-sol claude-kimi claude-opus) ;;
  bulk-generation)      chain=(claude-minimax claude-kimi claude-sol claude-opus) ;;
  review)               chain=(claude-kimi claude-opus) ;;
  research)             chain=(claude-kimi claude-sol claude-minimax claude-opus) ;;
  *)
    print -u2 "claude-agent: unknown role '${role:-}'"
    print -u2 "use: implementation-hard|frontend-greenfield|frontend-integration|bulk-generation|review|research"
    exit 2
    ;;
esac
required_worker=${chain[1]}

unavailable_re='usage limit|out of quota|quota exceeded|quota.*exhaust|membership/subscription|purchase extra usage|upgrade your plan|insufficient (quota|credit|balance)|invalid authentication|invalid api key|authentication_error|unauthorized|401 |403 |429 |rate limit|too many requests|overloaded|connection refused|econnrefused|dial tcp|502 bad gateway|503 service|service unavailable'

is_auth_unavailable() {
  local err="$1" rc="$2"
  (( rc != 0 )) || return 1
  print -r -- "$err" | grep -qiE 'auth_unavailable|invalid authentication|invalid api key|authentication_error|authentication failed|unauthorized|token (has )?expired|oauth.*(expired|invalid)'
}

is_unavailable() {
  local err="$1" rc="$2"
  (( rc != 0 )) || return 1
  print -r -- "$err" | grep -qiE "$unavailable_re|api error|request failed|fetch failed|network"
}

has_output() { [[ -n "${1//[[:space:]]/}" ]]; }

print_task_failed() {
  local w="$1" err="$2" excerpt
  excerpt="$(print -r -- "$err" | head -n 20 | cut -c1-240)"
  print -u2 "[claude-agent] TASK_FAILED worker=$w (exit 4); no provider fallback was attempted."
  if [[ -n "${excerpt//[[:space:]]/}" ]]; then
    print -u2 "[claude-agent] stderr excerpt:"
    print -u2 -r -- "$excerpt"
  else
    print -u2 "[claude-agent] stderr excerpt: <empty>"
  fi
}

# Start each command in its own session/process group so timeout cleanup reaches children.
run_timed() {
  local secs=$1 of=$2 ef=$3; shift 3
  if (( $+commands[setsid] )); then
    setsid "$@" </dev/null >"$of" 2>"$ef" &
  else
    python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' "$@" </dev/null >"$of" 2>"$ef" &
  fi
  local pid=$! timeout_marker="${of}.timeout.$$" watchdog rc pid_tmp
  pid_tmp="$RUN_DIR/.pid.$$"
  print -r -- "$pid" > "$pid_tmp" && mv "$pid_tmp" "$RUN_DIR/pid"
  (
    local target
    sleep "$secs"
    [[ -f "$RUN_DIR/pid" ]] || return 0
    target="$(<"$RUN_DIR/pid")"
    [[ "$target" == "$pid" ]] || return 0
    if kill -0 "$target" 2>/dev/null; then
      : > "$timeout_marker"
      kill -TERM -- -"$target" 2>/dev/null
      sleep 1
      kill -KILL -- -"$target" 2>/dev/null
    fi
  ) &
  watchdog=$!
  wait $pid 2>/dev/null
  rc=$?
  kill $watchdog 2>/dev/null
  wait $watchdog 2>/dev/null
  if [[ -f "$timeout_marker" ]]; then
    rm -f "$timeout_marker"
    return 124
  fi
  return $rc
}

args=("$@")
ORIGINAL_BRIEF=""
if [[ -n "$brief_file" ]]; then
  [[ -f "$brief_file" && -r "$brief_file" ]] || {
    print -u2 "claude-agent: brief is not a readable file: $brief_file"
    exit 2
  }
  brief_bytes="$(wc -c < "$brief_file" | tr -d '[:space:]')"
  [[ "$brief_bytes" == <-> ]] || brief_bytes=0
  if (( brief_bytes < 200 )); then
    print -u2 "claude-agent: brief is too short (${brief_bytes} bytes; minimum 200): $brief_file"
    exit 2
  fi
  for arg in "${args[@]}"; do
    [[ "$arg" == -p ]] && {
      print -u2 "claude-agent: use either --brief FILE or -p TEXT, not both"
      exit 2
    }
  done
  ORIGINAL_BRIEF="$(<"$brief_file")"
  args=(-p "$ORIGINAL_BRIEF" "${args[@]}")
else
  for (( arg_i=1; arg_i <= ${#args}; arg_i++ )); do
    if [[ "${args[$arg_i]}" == -p ]] && (( arg_i < ${#args} )); then
      ORIGINAL_BRIEF="${args[$(( arg_i + 1 ))]}"
      prompt_bytes="$(print -rn -- "$ORIGINAL_BRIEF" | wc -c | tr -d '[:space:]')"
      [[ "$prompt_bytes" == <-> ]] || prompt_bytes=0
      if (( prompt_bytes < 200 )); then
        print -u2 "[claude-agent] warning: ad-hoc -p prompt is short (${prompt_bytes} bytes; briefs should be at least 200 bytes)"
      fi
      break
    fi
  done
fi

task_args=("${args[@]}")
caller_sets_tools=0
for arg in "${args[@]}"; do
  case "$arg" in
    --allowedTools|--allowedTools=*|--tools|--tools=*) caller_sets_tools=1 ;;
  esac
done
if (( ! caller_sets_tools )); then
  case "$role" in
    review)
      task_args+=(--allowedTools "Read,Grep,Glob" --disallowedTools "Write,Edit,Bash")
      ;;
    bulk-generation)
      task_args+=(--allowedTools "Read,Write,Grep,Glob,Bash" --disallowedTools "Edit")
      ;;
    *)
      task_args+=(--allowedTools "Read,Write,Edit,Grep,Glob,Bash")
      ;;
  esac
fi

launcher_health_warning() {
  local worker health_state detail
  local -a dead
  local -A seen
  if [[ -f "$STATE_ROOT/doctor.tsv" ]]; then
    while IFS=$'\t' read -r worker health_state detail; do
      [[ "$health_state" == DEAD ]] && dead+=("$worker")
    done < "$STATE_ROOT/doctor.tsv"
  fi
  for worker in claude-sol claude-kimi claude-minimax; do
    [[ -x "$AGENT_BIN_DIR/$worker" ]] || dead+=("$worker")
  done
  [[ -f "$OPUS_TOKEN_FILE" && -r "$OPUS_TOKEN_FILE" && -s "$OPUS_TOKEN_FILE" ]] || dead+=(claude-opus)
  local -a unique
  for worker in "${dead[@]}"; do
    [[ -n "${seen[$worker]}" ]] && continue
    seen[$worker]=1
    unique+=("$worker")
  done
  if (( ${#unique} )); then
    print -u2 "[claude-agent] doctor warning: documented rung(s) dead: ${(j:, :)unique} (run: claude-agent doctor)"
  fi
}
launcher_health_warning

