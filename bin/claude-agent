sha256_short() {
  if (( $+commands[shasum] )); then
    print -rn -- "$1" | shasum -a 256 | awk '{print substr($1,1,16)}'
  elif (( $+commands[sha256sum] )); then
    print -rn -- "$1" | sha256sum | awk '{print substr($1,1,16)}'
  else
    print -u2 "claude-agent: shasum or sha256sum is required"
    return 2
  fi
}

sha256_file() {
  if (( $+commands[shasum] )); then
    shasum -a 256 "$1" | awk '{print $1}'
  elif (( $+commands[sha256sum] )); then
    sha256sum "$1" | awk '{print $1}'
  else
    print -u2 "claude-agent: shasum or sha256sum is required"
    return 2
  fi
}

write_run_state() {
  local state="$1" now sequence tmp metadata="" value
  [[ -n "$RUN_DIR" ]] || return 0
  now="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  sequence="$(date -u '+%s')"
  if [[ -s "$RUN_DIR/effective-model" ]]; then
    value="$(<"$RUN_DIR/effective-model")"
    metadata+=",\"model\":\"$value\""
  fi
  if [[ -s "$RUN_DIR/effective-reasoning" ]]; then
    value="$(<"$RUN_DIR/effective-reasoning")"
    metadata+=",\"reasoning\":\"$value\""
  fi
  if [[ -s "$RUN_DIR/effective-speed" ]]; then
    value="$(<"$RUN_DIR/effective-speed")"
    metadata+=",\"speed\":\"$value\""
  fi
  tmp="$RUN_DIR/.run-state.json.$$"
  print -r -- "{\"schemaVersion\":1,\"sequence\":$sequence,\"state\":\"$state\",\"heartbeatAt\":\"$now\"$metadata}" > "$tmp" && \
    mv "$tmp" "$RUN_DIR/run-state.json"
}

record_effective_metadata() {
  local worker="$1" model="" reasoning="${WORKJET_EFFECTIVE_REASONING:-}" speed="${WORKJET_EFFECTIVE_SPEED:-}" thinking i
  shift
  case "$worker" in
    claude-sol)
      model="${SOL_MODEL:-gpt-5.6-sol}"
      thinking="${SOL_THINKING:-32000}"
      [[ -z "$reasoning" && "$thinking" == <-> ]] && (( thinking >= 10000 )) && reasoning=high
      ;;
    claude-kimi) model="${KIMI_MODEL:-k3[1m]}" ;;
    claude-minimax) model="${MINIMAX_MODEL:-MiniMax-M3}" ;;
    claude-opus) model="${OPUS_MODEL:-claude-opus-4-8}" ;;
  esac
  local -a args=("$@")
  for (( i=1; i <= ${#args}; i++ )); do
    case "${args[$i]}" in
      --model)
        (( i < ${#args} )) && model="${args[$(( i + 1 ))]}"
        ;;
      --model=*) model="${args[$i]#--model=}" ;;
      --effort)
        (( i < ${#args} )) && reasoning="${args[$(( i + 1 ))]}"
        ;;
      --effort=*) reasoning="${args[$i]#--effort=}" ;;
      --speed)
        (( i < ${#args} )) && speed="${args[$(( i + 1 ))]}"
        ;;
      --speed=*) speed="${args[$i]#--speed=}" ;;
      --fast) speed=fast ;;
    esac
  done
  if (( ${#model} == 0 || ${#model} > 256 )) || ! print -rn -- "$model" | LC_ALL=C grep -Eq '^[][A-Za-z0-9._:/@+-]+$'; then
    model=""
  fi
  case "$reasoning" in low|medium|high|xhigh|max|ultra|ultracode|ultrathink) ;; *) reasoning="" ;; esac
  case "$speed" in fast|normal) ;; *) speed="" ;; esac
  rm -f "$RUN_DIR/effective-model" "$RUN_DIR/effective-reasoning" "$RUN_DIR/effective-speed"
  [[ -n "$model" ]] && print -r -- "$model" > "$RUN_DIR/effective-model"
  [[ -n "$reasoning" ]] && print -r -- "$reasoning" > "$RUN_DIR/effective-reasoning"
  [[ -n "$speed" ]] && print -r -- "$speed" > "$RUN_DIR/effective-speed"
  write_run_state running
}

init_run_dir() {
  local stamp raw_id index_tmp
  stamp="$(date +%Y%m%dT%H%M%S)-$$"
  if [[ -n "$run_dir_override" ]]; then
    RUN_DIR="${run_dir_override:A}"
    raw_id="${RUN_DIR:t}-${stamp}"
  else
    raw_id="${stamp}-${role}"
    RUN_DIR="$STATE_ROOT/runs/$raw_id"
  fi
  RUN_ID="${raw_id//[^A-Za-z0-9._-]/_}"
  [[ -n "$RUN_ID" && "$RUN_ID" != .* ]] || RUN_ID="run-$stamp"
  mkdir -p "$RUN_DIR/attempts" "$RUN_DIR/journal" "$STATE_ROOT/run-index" || {
    print -u2 "claude-agent: cannot create run directory: $RUN_DIR"
    exit 2
  }
  chmod 700 "$RUN_DIR" 2>/dev/null || true
  index_tmp="$STATE_ROOT/run-index/.${RUN_ID}.$$"
  print -r -- "$RUN_DIR" > "$index_tmp" && mv "$index_tmp" "$STATE_ROOT/run-index/$RUN_ID"
  print -rn -- "$ORIGINAL_BRIEF" > "$RUN_DIR/brief.txt"
  [[ -n "$brief_file" ]] && print -r -- "${brief_file:A}" > "$RUN_DIR/brief-path"
  sha256_file "$RUN_DIR/brief.txt" > "$RUN_DIR/brief.sha256" || exit 2
  date -u '+%Y-%m-%dT%H:%M:%SZ' > "$RUN_DIR/started-at"
  touch "$RUN_DIR/heartbeat"
  : > "$RUN_DIR/stdout"
  : > "$RUN_DIR/stderr"
  : > "$RUN_DIR/worker"
  : > "$RUN_DIR/worktree-path"
  print -r -- "$RUN_ID" > "$RUN_DIR/run-id"
  write_run_state running
  if [[ -n "$repo_root" ]]; then
    RUN_GIT_BEFORE="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null)"
    print -r -- "$RUN_GIT_BEFORE" > "$RUN_DIR/git-head-before"
    REPO_ID="$(sha256_short "$repo_root")" || exit 2
    print -r -- "$REPO_ID" > "$RUN_DIR/repo-id"
  fi
}

record_attempt() {
  local worker="$1" out="$2" err="$3" attempt_rc="$4" kind="$5" attempt_dir
  RUN_WORKER="$worker"
  (( ++ATTEMPT_COUNT ))
  attempt_dir="$RUN_DIR/attempts/$(printf '%02d' $ATTEMPT_COUNT)-$worker"
  mkdir -p "$attempt_dir"
  print -r -- "$worker" > "$attempt_dir/worker"
  print -r -- "$kind" > "$attempt_dir/kind"
  print -r -- "$attempt_rc" > "$attempt_dir/rc"
  print -rn -- "$out" > "$attempt_dir/stdout"
  print -rn -- "$err" > "$attempt_dir/stderr"
  if [[ "$kind" == task ]]; then
    RUN_TASK_WORKER="$worker"
    FINAL_TASK_STDOUT="$attempt_dir/stdout"
  fi
  print -r -- "$RUN_WORKER" > "$RUN_DIR/worker"
  print -rn -- "$out" > "$RUN_DIR/stdout"
  print -rn -- "$err" > "$RUN_DIR/stderr"
}

path_is_allowed() {
  setopt local_options
  unsetopt bad_pattern
  local changed="$1" pattern
  for pattern in ${(s:,:)allowed_paths}; do
    pattern="$(print -r -- "$pattern" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [[ -n "$pattern" && "$changed" == ${~pattern} ]] && return 0
  done
  return 1
}

audit_allowed_paths() {
  [[ -n "$allowed_paths" && -n "$repo_root" ]] || return 0
  if [[ -z "$RUN_TASK_WORKER" ]]; then
    rm -f "$RUN_DIR/path-violations.txt" "$RUN_DIR/path-violations.txt.tmp"
    return 0
  fi
  local git_target="$repo_root" diff_base="$RUN_GIT_BEFORE" changed names_file violation_file
  local -A seen
  [[ -n "$RUN_WORKTREE" && -d "$RUN_WORKTREE" ]] && git_target="$RUN_WORKTREE"
  [[ -n "$RUN_SCOPE_BEFORE" ]] && diff_base="$RUN_SCOPE_BEFORE"
  names_file="$(mktemp "${TMPDIR:-/tmp}/workjet-paths.XXXXXX")" || return 0
  violation_file="$RUN_DIR/path-violations.txt"
  git -C "$git_target" diff --name-only -z "$diff_base" -- > "$names_file" 2>/dev/null || true
  git -C "$git_target" ls-files --others --exclude-standard -z >> "$names_file" 2>/dev/null || true
  : > "${violation_file}.tmp"
  while IFS= read -r -d '' changed; do
    [[ -n "${seen[$changed]}" ]] && continue
    seen[$changed]=1
    if ! path_is_allowed "$changed"; then
      print -r -- "$changed" >> "${violation_file}.tmp"
      print -u2 "[claude-agent] PATH_VIOLATION: $changed (allowed: $allowed_paths)"
    fi
  done < "$names_file"
  rm -f "$names_file"
  if [[ -s "${violation_file}.tmp" ]]; then
    mv "${violation_file}.tmp" "$violation_file"
    print -u2 "[claude-agent] path audit flagged changes; see: $violation_file"
  else
    rm -f "${violation_file}.tmp" "$violation_file"
  fi
}

start_journal() {
  (
    local last_diff now seq=0 target worktree
    last_diff="$(date +%s)"
    while true; do
      sleep "$HEARTBEAT_INTERVAL"
      touch "$RUN_DIR/heartbeat"
      write_run_state running
      now="$(date +%s)"
      if (( now - last_diff >= DIFFSTAT_INTERVAL )); then
        (( ++seq ))
        target="$repo_root"
        if [[ -s "$RUN_DIR/worktree-path" ]]; then
          worktree="$(<"$RUN_DIR/worktree-path")"
          [[ -d "$worktree" ]] && target="$worktree"
        fi
        if [[ -n "$target" ]]; then
          git -C "$target" diff --stat "$RUN_GIT_BEFORE" -- > "$RUN_DIR/journal/diffstat-$(printf '%04d' $seq)" 2>/dev/null || \
            : > "$RUN_DIR/journal/diffstat-$(printf '%04d' $seq)"
        else
          : > "$RUN_DIR/journal/diffstat-$(printf '%04d' $seq)"
        fi
        date -u '+%Y-%m-%dT%H:%M:%SZ' > "$RUN_DIR/journal/diffstat-$(printf '%04d' $seq).at"
        last_diff=$now
      fi
    done
  ) &
  JOURNAL_PID=$!
  print -r -- "$JOURNAL_PID" > "$RUN_DIR/journal-pid"
}

stop_journal() {
  if [[ -n "$JOURNAL_PID" ]]; then
    kill "$JOURNAL_PID" 2>/dev/null || true
    wait "$JOURNAL_PID" 2>/dev/null || true
  fi
}

write_completion_receipt() {
  local final_rc="$1" finished_at="$2"
  python3 - "$RUN_DIR" "$RUN_ID" "$role" "$required_worker" "$RUN_TASK_WORKER" \
    "$final_rc" "$finished_at" "$TASK_TIMED_OUT" "$TAMPER_DETECTED" "$allowed_paths" \
    "$FINAL_TASK_STDOUT" <<'PY'
import json
import os
import re
import stat
import sys
import tempfile

(
    run_dir,
    run_id,
    role,
    required_worker,
    actual_worker,
    final_rc_raw,
    finished_at,
    timeout_raw,
    tamper_raw,
    allowed_paths,
    task_stdout,
) = sys.argv[1:]

MAX_TAIL = 65536
MAX_RECEIPT = 32768
OPEN = b"```workjet-completion-receipt-v1\n"
CLOSE = b"\n```"


def bounded_text(value, maximum, allow_empty=True):
    if not isinstance(value, str) or len(value) > maximum:
        raise ValueError("string-bound")
    if not allow_empty and not value:
        raise ValueError("empty-string")
    if any(ord(ch) < 32 or ord(ch) == 127 for ch in value):
        raise ValueError("control-character")
    return value


def bounded_list(value, maximum, item_maximum):
    if not isinstance(value, list) or len(value) > maximum:
        raise ValueError("list-bound")
    return [bounded_text(item, item_maximum) for item in value]


def parse_claims(path):
    if not path:
        return "missing", "no-task-attempt", None
    try:
        info = os.lstat(path)
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
            return "invalid", "untrusted-task-stdout", None
        with open(path, "rb") as handle:
            if info.st_size > MAX_TAIL:
                handle.seek(-MAX_TAIL, os.SEEK_END)
            tail = handle.read(MAX_TAIL)
    except OSError:
        return "invalid", "unreadable-task-stdout", None

    if OPEN not in tail:
        return "missing", "receipt-block-absent", None
    start = tail.rfind(OPEN)
    if start > 0 and tail[start - 1 : start] != b"\n":
        return "invalid", "receipt-opener-not-on-line", None
    block = tail[start:].rstrip(b" \t\r\n")
    if not block.endswith(CLOSE):
        return "invalid", "receipt-not-final-or-unclosed", None
    payload = block[len(OPEN) : -len(CLOSE)]
    if not payload or len(payload) > MAX_RECEIPT or b"\n" in payload or b"\r" in payload:
        return "invalid", "receipt-size-or-shape", None
    try:
        raw = json.loads(payload.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError):
        return "invalid", "receipt-json", None

    expected = {
        "schemaVersion",
        "status",
        "summary",
        "changedFiles",
        "verification",
        "concerns",
        "producedPaths",
    }
    try:
        if not isinstance(raw, dict) or set(raw) != expected or raw.get("schemaVersion") != 1:
            raise ValueError("schema")
        status = bounded_text(raw["status"], 32, allow_empty=False)
        if status not in {"completed", "partial", "failed", "blocked"}:
            raise ValueError("status")
        summary = bounded_text(raw["summary"], 2000)
        changed_files = bounded_list(raw["changedFiles"], 100, 1024)
        concerns = bounded_list(raw["concerns"], 50, 2048)
        produced_paths = bounded_list(raw["producedPaths"], 100, 1024)
        verification_raw = raw["verification"]
        if not isinstance(verification_raw, list) or len(verification_raw) > 50:
            raise ValueError("verification-bound")
        verification = []
        for item in verification_raw:
            if not isinstance(item, dict) or set(item) != {"command", "result"}:
                raise ValueError("verification-schema")
            verification.append(
                {
                    "command": bounded_text(item["command"], 2048),
                    "result": bounded_text(item["result"], 4096),
                }
            )
    except (KeyError, ValueError, TypeError):
        return "invalid", "receipt-contract", None

    return (
        "valid",
        "validated",
        {
            "schemaVersion": 1,
            "status": status,
            "summary": summary,
            "changedFiles": changed_files,
            "verification": verification,
            "concerns": concerns,
            "producedPaths": produced_paths,
        },
    )


def read_text(name, maximum=65536):
    path = os.path.join(run_dir, name)
    try:
        info = os.lstat(path)
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
            return None, False
        with open(path, "rb") as handle:
            raw = handle.read(maximum + 1)
    except OSError:
        return None, False
    truncated = len(raw) > maximum
    raw = raw[:maximum]
    try:
        return raw.decode("utf-8", "replace").rstrip("\n"), truncated
    except Exception:
        return None, truncated


final_rc = int(final_rc_raw)
classification = {
    0: "delivered",
    3: "primary_unavailable",
    4: "task_failed",
    10: "degraded",
}.get(final_rc, "other")
receipt_status, receipt_detail, claims = parse_claims(task_stdout)
started_at, _ = read_text("started-at", 64)
worktree_path, _ = read_text("worktree-path", 4096)
git_before, _ = read_text("git-head-before", 128)
git_after, _ = read_text("git-head-after", 128)
protected_ref, _ = read_text("protected-ref", 512)
protected_sha, _ = read_text("protected-sha", 128)
diffstat, diffstat_truncated = read_text("diffstat", 65536)

violations_path = os.path.join(run_dir, "path-violations.txt")
violation_count = 0
if not allowed_paths:
    violation_state = "not_requested"
else:
    try:
        info = os.lstat(violations_path)
        if stat.S_ISREG(info.st_mode) and not stat.S_ISLNK(info.st_mode) and info.st_size:
            with open(violations_path, "rb") as handle:
                violation_count = min(10000, sum(1 for _ in handle))
            violation_state = "violated"
        else:
            violation_state = "clean"
    except OSError:
        violation_state = "clean"

worktree = None
if worktree_path or git_before or git_after:
    worktree = {
        "path": worktree_path or None,
        "gitHeadBefore": git_before or None,
        "gitHeadAfter": git_after or None,
    }
protected = None
if protected_ref or protected_sha:
    protected = {"ref": protected_ref or None, "sha": protected_sha or None}

completion = {
    "schemaVersion": 1,
    "receipt": {"status": receipt_status, "detail": receipt_detail},
    "claims": claims,
    "observations": {
        "runId": run_id,
        "role": role,
        "requiredWorker": required_worker,
        "actualWorker": actual_worker or None,
        "terminal": {"exitCode": final_rc, "classification": classification},
        "timestamps": {"startedAt": started_at, "finishedAt": finished_at},
        "flags": {"timeout": timeout_raw == "1", "tamper": tamper_raw == "1"},
        "worktree": worktree,
        "protectedResult": protected,
        "pathViolation": {"state": violation_state, "count": violation_count},
        "diffstat": diffstat or "",
        "diffstatTruncated": diffstat_truncated,
    },
}

fd, temporary = tempfile.mkstemp(prefix=".completion.json.", dir=run_dir)
try:
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(completion, handle, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, os.path.join(run_dir, "completion.json"))
    try:
        directory_fd = os.open(run_dir, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except OSError:
        pass
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
}

finalize_run() {
  local final_rc="$1" git_target git_after diffstat finished_at
  stop_journal
  finished_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  print -r -- "$final_rc" > "$RUN_DIR/rc"
  print -r -- "$RUN_WORKER" > "$RUN_DIR/worker"
  print -r -- "$RUN_WORKTREE" > "$RUN_DIR/worktree-path"
  if [[ -n "$repo_root" ]]; then
    git_target="$repo_root"
    [[ -n "$RUN_WORKTREE" && -d "$RUN_WORKTREE" ]] && git_target="$RUN_WORKTREE"
    git_after="$(git -C "$git_target" rev-parse HEAD 2>/dev/null)"
    print -r -- "$git_after" > "$RUN_DIR/git-head-after"
    diffstat="$(git -C "$git_target" diff --stat "$RUN_GIT_BEFORE" -- 2>/dev/null)"
    print -rn -- "$diffstat" > "$RUN_DIR/diffstat"
  fi
  audit_allowed_paths
  print -r -- "$final_rc" > "$RUN_DIR/exit-code"
  {
    print -r -- "rc=$final_rc"
    print -r -- "finished_at=$finished_at"
    (( TAMPER_DETECTED )) && print -r -- "tamper=true"
    (( TASK_TIMED_OUT )) && print -r -- "timeout=true"
  } > "$RUN_DIR/exit"
  if (( final_rc == 0 )); then
    write_run_state completed
  else
    write_run_state failed
  fi
  if ! write_completion_receipt "$final_rc" "$finished_at"; then
    print -u2 "[claude-agent] warning: could not persist completion receipt telemetry"
  fi
  print -u2 "[claude-agent] run directory: $RUN_DIR"
}

init_run_dir
start_journal
trap 'finalize_run $?' EXIT

capture_dirty_patch() {
  local checkout_status index_file git_dir
  [[ -n "$repo_root" ]] || return 0
  checkout_status="$(git -C "$repo_root" status --porcelain --untracked-files=all)"
  [[ -n "$checkout_status" ]] || return 0
  if (( ! include_dirty )); then
    print -u2 "[claude-agent] main checkout is dirty; refusing to start a worker."
    print -u2 "[claude-agent] commit/stash all staged, unstaged, and untracked changes, or pass --include-dirty to copy them intentionally."
    print -u2 -r -- "$checkout_status"
    return 4
  fi
  index_file="$(mktemp "${TMPDIR:-/tmp}/workjet-index.XXXXXX")" || return 4
  rm -f "$index_file"
  git_dir="$(git -C "$repo_root" rev-parse --git-dir)"
  [[ "$git_dir" == /* ]] || git_dir="$repo_root/$git_dir"
  if [[ -f "$git_dir/index" ]]; then
    cp "$git_dir/index" "$index_file" || { rm -f "$index_file"; return 4; }
  else
    GIT_INDEX_FILE="$index_file" git -C "$repo_root" read-tree HEAD || { rm -f "$index_file"; return 4; }
  fi
  if ! GIT_INDEX_FILE="$index_file" git -C "$repo_root" add -A -- .; then
    rm -f "$index_file"
    print_task_failed "dirty snapshot" "could not stage checkout into a temporary index"
    return 4
  fi
  if ! GIT_INDEX_FILE="$index_file" git -C "$repo_root" diff --cached --binary --full-index HEAD -- > "$RUN_DIR/dirty.patch"; then
    rm -f "$index_file"
    print_task_failed "dirty snapshot" "could not archive dirty checkout patch"
    return 4
  fi
  rm -f "$index_file"
  print -u2 "[claude-agent] archived and included dirty checkout: $RUN_DIR/dirty.patch"
}

capture_dirty_patch || exit 4
if [[ -n "$repo_root" ]]; then
  MAIN_STATUS_BEFORE="$(git -C "$repo_root" status --porcelain --untracked-files=all)"
  print -rn -- "$MAIN_STATUS_BEFORE" > "$RUN_DIR/main-status-before"
fi

check_main_tamper() {
  [[ -n "$repo_root" ]] || return 0
  local after
  after="$(git -C "$repo_root" status --porcelain --untracked-files=all)"
  print -rn -- "$after" > "$RUN_DIR/main-status-after"
  [[ "$after" == "$MAIN_STATUS_BEFORE" ]] && return 0
  TAMPER_DETECTED=1
  : > "$RUN_DIR/tamper"
  print -u2 ""
  print -u2 "████████████████████████ TAMPER DETECTED ████████████████████████"
  print -u2 "[claude-agent] FAILED: the main checkout changed while the worker ran."
  print -u2 "[claude-agent] protected checkout: $repo_root"
  print -u2 "[claude-agent] before/after snapshots: $RUN_DIR/main-status-before $RUN_DIR/main-status-after"
  print -u2 "████████████████████████████████████████████████████████████████"
  return 1
}

cleanup_stale_worktrees() {
  [[ -n "$repo_root" ]] || return 0
  local root="$STATE_ROOT/worktrees/$REPO_ID"
  [[ -d "$root" ]] || return 0
  prune_worktrees 0 "$root" 1 1 >&2
}

cleanup_stale_worktrees

create_worktree() {
  local root="$STATE_ROOT/worktrees/$REPO_ID"
  WORKTREE_PATH="$root/$RUN_ID"
  WORKTREE_BASE="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null)" || return 4
  mkdir -p "$root"
  if [[ -e "$WORKTREE_PATH" ]]; then
    print_task_failed "worktree setup" "worktree path already exists: $WORKTREE_PATH"
    return 4
  fi
  if ! git -C "$repo_root" worktree add --detach --quiet "$WORKTREE_PATH" "$WORKTREE_BASE"; then
    print_task_failed "worktree setup" "git worktree add failed for $WORKTREE_PATH"
    WORKTREE_PATH=""
    return 4
  fi
  RUN_WORKTREE="$WORKTREE_PATH"
  print -r -- "$RUN_WORKTREE" > "$RUN_DIR/worktree-path"
  WORKER_CWD="$WORKTREE_PATH$repo_subdir"
  if [[ ! -d "$WORKER_CWD" ]]; then
    print -u2 "[claude-agent] warning: matching subdirectory absent at HEAD; worker starts at worktree root"
    WORKER_CWD="$WORKTREE_PATH"
  fi
}

checkpoint_failed_attempt() {
  local wt="$1" ref sha
  (( FAILED_CHECKPOINT_COUNT++ ))
  ref="refs/workjet/${RUN_ID}-failed-${FAILED_CHECKPOINT_COUNT}"
  if [[ -n "$(git -C "$wt" status --porcelain --untracked-files=all)" ]]; then
    git -C "$wt" add -A -- . || return 4
    git -C "$wt" -c user.name=workjet -c user.email=workjet@localhost \
      -c commit.gpgsign=false commit --no-verify -q -m "workjet: preserve failed attempt $RUN_ID/$FAILED_CHECKPOINT_COUNT" || return 4
  fi
  sha="$(git -C "$wt" rev-parse HEAD)" || return 4
  git -C "$repo_root" update-ref "$ref" "$sha" || return 4
  print -u2 "[claude-agent] preserved failed attempt before retry: $ref ($sha)"
}

prepare_worktree() {
  if [[ -z "$WORKTREE_PATH" ]]; then
    create_worktree || return 4
  elif (( WORKTREE_USE_COUNT > 0 )); then
    checkpoint_failed_attempt "$WORKTREE_PATH" || {
      print_task_failed "worktree checkpoint" "could not preserve the previous failed attempt"
      return 4
    }
    git -C "$WORKTREE_PATH" reset --hard -q "$WORKTREE_BASE" || return 4
    git -C "$WORKTREE_PATH" clean -fdx -q || return 4
  fi
  if [[ -f "$RUN_DIR/dirty.patch" ]]; then
    git -C "$WORKTREE_PATH" apply --binary "$RUN_DIR/dirty.patch" || {
      print_task_failed "dirty snapshot" "could not apply $RUN_DIR/dirty.patch to $WORKTREE_PATH"
      return 4
    }
  fi
  capture_scope_baseline "$WORKTREE_PATH" || {
    print_task_failed "path audit baseline" "could not snapshot the worker's initial worktree"
    return 4
  }
  (( ++WORKTREE_USE_COUNT ))
  return 0
}

capture_scope_baseline() {
  local worktree="$1" index_file git_dir tree
  index_file="$(mktemp "${TMPDIR:-/tmp}/workjet-scope-index.XXXXXX")" || return 4
  rm -f "$index_file"
  git_dir="$(git -C "$worktree" rev-parse --git-dir)" || { rm -f "$index_file"; return 4; }
  [[ "$git_dir" == /* ]] || git_dir="$worktree/$git_dir"
  if [[ -f "$git_dir/index" ]]; then
    cp "$git_dir/index" "$index_file" || { rm -f "$index_file"; return 4; }
  else
    GIT_INDEX_FILE="$index_file" git -C "$worktree" read-tree HEAD || { rm -f "$index_file"; return 4; }
  fi
  GIT_INDEX_FILE="$index_file" git -C "$worktree" add -A -- . || { rm -f "$index_file"; return 4; }
  tree="$(GIT_INDEX_FILE="$index_file" git -C "$worktree" write-tree)" || { rm -f "$index_file"; return 4; }
  rm -f "$index_file"
  RUN_SCOPE_BEFORE="$tree"
  print -r -- "$RUN_SCOPE_BEFORE" > "$RUN_DIR/scope-tree-before"
}

protect_successful_worktree() {
  local wt="$1" ref="refs/workjet/$RUN_ID" sha
  if [[ -n "$(git -C "$wt" status --porcelain --untracked-files=all)" ]]; then
    git -C "$wt" add -A -- . || return 4
    git -C "$wt" -c user.name=workjet -c user.email=workjet@localhost \
      -c commit.gpgsign=false commit --no-verify -q -m "workjet: preserve run $RUN_ID" || return 4
  fi
  sha="$(git -C "$wt" rev-parse HEAD)" || return 4
  git -C "$repo_root" update-ref "$ref" "$sha" || return 4
  print -r -- "$ref" > "$RUN_DIR/protected-ref"
  print -r -- "$sha" > "$RUN_DIR/protected-sha"
  print -u2 "[claude-agent] protected successful result: $ref ($sha)"
}

salvage_timeout() {
  local wt="$1" base="$2" ref="refs/workjet/$RUN_ID" sha
  TASK_TIMED_OUT=1
  : > "$RUN_DIR/timeout"
  git -C "$wt" add -A -- . || return 4
  git -C "$wt" -c user.name=workjet -c user.email=workjet@localhost \
    -c commit.gpgsign=false commit --allow-empty --no-verify -q -m "wip: $RUN_ID" || return 4
  sha="$(git -C "$wt" rev-parse HEAD)" || return 4
  git -C "$repo_root" update-ref "$ref" "$sha" || return 4
  print -r -- "$ref" > "$RUN_DIR/protected-ref"
  print -r -- "$sha" > "$RUN_DIR/protected-sha"
  git -C "$wt" diff --binary --full-index "$base..$sha" -- > "$RUN_DIR/timeout.diff" 2>/dev/null || \
    : > "$RUN_DIR/timeout.diff"
  git -C "$wt" diff --stat "$base..$sha" -- > "$RUN_DIR/timeout.diffstat" 2>/dev/null || \
    : > "$RUN_DIR/timeout.diffstat"
  print -u2 "[claude-agent] TIMEOUT SALVAGE: committed worktree as 'wip: $RUN_ID'"
  print -u2 "[claude-agent] TIMEOUT SALVAGE: protected $ref at $sha"
  print -u2 "[claude-agent] TIMEOUT SALVAGE: diff report $RUN_DIR/timeout.diff"
}

report_worktree() {
  local wt="$1" base="$2" wt_status diffstat
  RUN_WORKTREE="$wt"
  wt_status="$(git -C "$wt" status --short 2>/dev/null | head)"
  diffstat="$(git -C "$wt" diff --stat "$base" -- 2>/dev/null)"
  [[ -z "$diffstat" ]] && diffstat="$(git -C "$wt" diff --stat "$base..HEAD" -- 2>/dev/null)"
  print -u2 "[claude-agent] worktree retained: $wt"
  print -u2 "[claude-agent] worktree status (first 10 lines):"
  print -u2 -r -- "${wt_status:-<clean; result committed on protected ref>}"
  print -u2 "[claude-agent] worktree diffstat:"
  print -u2 -r -- "${diffstat:-<no diff>}"
}

completion_receipt_prompt() {
  load_visible_prompt_block '<!-- WORKJET COMPLETION RECEIPT PROMPT BEGIN -->' '<!-- WORKJET COMPLETION RECEIPT PROMPT END -->' 'completion receipt prompt'
}

inject_preamble() {
  local isolated_path="$1" i prompt receipt_prompt
  shift
  INVOKE_ARGS=("$@")
  local prompt_file="$HOME/.claude/workjet/AGENTS.md"
  if [[ ! -r "$prompt_file" ]]; then
    print -u2 "[claude-agent] visible worker preamble unavailable: $prompt_file"
    return 2
  fi
  prompt="$(sed -n '/^<!-- WORKJET WORKER PREAMBLE BEGIN -->$/,/^<!-- WORKJET WORKER PREAMBLE END -->$/p' "$prompt_file" | sed '1d;$d')"
  if [[ -z "$prompt" ]]; then
    print -u2 "[claude-agent] visible worker preamble is missing from Workjet technical rules"
    return 2
  fi
  prompt="${prompt//<WORKJET_CHECKOUT>/$isolated_path}"
  receipt_prompt="$(completion_receipt_prompt)" || return 2
  prompt+=$'\n\n'"$receipt_prompt"
  for (( i=1; i <= ${#INVOKE_ARGS}; i++ )); do
    if [[ "${INVOKE_ARGS[$i]}" == -p ]] && (( i < ${#INVOKE_ARGS} )); then
      prompt+=$'\n\n'"${INVOKE_ARGS[$(( i + 1 ))]}"
      INVOKE_ARGS[$(( i + 1 ))]="$prompt"
      print -rn -- "$prompt" > "$RUN_DIR/prompt.txt"
      return 0
    fi
  done
}

file_epoch() {
  stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1" 2>/dev/null
}

proxy_token_path() {
  local candidate candidate_epoch newest="" newest_epoch=0
  local -a candidates
  if [[ -n "$CLIPROXY_TOKEN_FILE" ]]; then
    [[ -f "$CLIPROXY_TOKEN_FILE" ]] && print -r -- "$CLIPROXY_TOKEN_FILE"
    return
  fi
  candidates=("$HOME"/.cli-proxy-api/codex-*.json(N))
  for candidate in "${candidates[@]}"; do
    candidate_epoch="$(file_epoch "$candidate")"
    [[ "$candidate_epoch" == <-> ]] || continue
    if (( candidate_epoch > newest_epoch )); then
      newest="$candidate"
      newest_epoch=$candidate_epoch
    fi
  done
  [[ -n "$newest" ]] && print -r -- "$newest"
}

proxy_listener_pid() {
  if [[ -n "${CLIPROXY_PID:-}" ]]; then
    print -r -- "$CLIPROXY_PID"
  else
    lsof -nP -iTCP:8317 -sTCP:LISTEN -t 2>/dev/null | head -n 1
  fi
}

proxy_start_epoch() {
  local pid="$1"
  if [[ -n "${CLIPROXY_START_EPOCH:-}" ]]; then
    print -r -- "$CLIPROXY_START_EPOCH"
    return
  fi
  python3 - "$pid" <<'PY'
import datetime
import subprocess
import sys

try:
    value = subprocess.check_output(
        ["ps", "-o", "lstart=", "-p", sys.argv[1]], text=True
    ).strip()
    started = datetime.datetime.strptime(value, "%a %b %d %H:%M:%S %Y")
    print(int(started.timestamp()))
except Exception:
    raise SystemExit(1)
PY
}

restart_cliproxy() {
  (( PROXY_RESTARTED )) && return 1
  PROXY_RESTARTED=1
  print -u2 "[claude-agent] restarting cliproxyapi once to load the newer OAuth token"
  if ! brew services restart cliproxyapi >/dev/null 2>&1; then
    print -u2 "[claude-agent] cliproxyapi restart command failed"
    return 1
  fi
  sleep "$CLIPROXY_RESTART_DELAY"
}

restart_proxy_for_fresh_token() {
  local token pid token_epoch started_epoch
  [[ "$1" == claude-sol ]] || return 1
  (( PROXY_RESTARTED )) && return 1
  token="$(proxy_token_path)"
  pid="$(proxy_listener_pid)"
  [[ -n "$token" && "$pid" == <-> ]] || return 1
  token_epoch="$(file_epoch "$token")"
  started_epoch="$(proxy_start_epoch "$pid")"
  [[ "$token_epoch" == <-> && "$started_epoch" == <-> ]] || return 1
  if (( token_epoch > started_epoch )); then
    print -u2 "[claude-agent] auth_unavailable: token is newer than proxy start ($token)"
    restart_cliproxy
    return 0
  fi
  return 1
}

ensure_proxy() {
  [[ "$1" == claude-sol ]] || return 0
  lsof -nP -iTCP:8317 -sTCP:LISTEN >/dev/null 2>&1 && return 0
  print -u2 "[claude-agent] cliproxyapi not listening — starting it (restores the intended worker)"
  brew services start cliproxyapi >/dev/null 2>&1
  sleep "$CLIPROXY_RESTART_DELAY"
}

invoke_worker() {
  local w="$1" timeout="$2" of="$3" ef="$4"
  shift 4
  ensure_proxy "$w"
  record_effective_metadata "$w" "$@"
  run_timed "$timeout" "$of" "$ef" /usr/bin/env WORKJET_OBSERVER_BYPASS=1 "$AGENT_BIN_DIR/$w" "$@"
}

probe_cache_file() {
  print -r -- "$STATE_ROOT/probe-last-good/$1"
}

probe_cache_is_good() {
  local cache age now cached_at
  (( PROBE_CACHE_TTL > 0 )) || return 1
  cache="$(probe_cache_file "$1")"
  [[ -f "$cache" && -x "$AGENT_BIN_DIR/$1" ]] || return 1
  cached_at="$(<"$cache")"
  [[ "$cached_at" == <-> ]] || cached_at="$(file_epoch "$cache")"
  [[ "$cached_at" == <-> ]] || return 1
  now="$(date +%s)"
  age=$(( now - cached_at ))
  (( age >= 0 && age < PROBE_CACHE_TTL )) || return 1
  print -u2 "[claude-agent] $1 probe last-good cache hit (${age}s old; skipping re-probe)"
}

mark_probe_good() {
  local cache tmp
  cache="$(probe_cache_file "$1")"
  mkdir -p "${cache:h}"
  tmp="${cache}.$$"
  date +%s > "$tmp" && mv "$tmp" "$cache"
}

probe_available() {
  local w="$1" of ef rc out err probe_out_excerpt probe_failure attempt=0 max_attempts
  local last_kind=provider last_err="" delay
  max_attempts=$(( PROBE_RETRIES + 1 ))
  (( max_attempts > 0 )) || max_attempts=1

  if probe_cache_is_good "$w"; then
    return 0
  fi
  if [[ ! -x "$AGENT_BIN_DIR/$w" ]]; then
    print -u2 "[claude-agent] $w probe provider_unavailable: worker executable missing: $AGENT_BIN_DIR/$w"
    return 1
  fi

  while (( attempt < max_attempts )); do
    (( ++attempt ))
    of=$(mktemp); ef=$(mktemp)
    INVOKE_ARGS=(-p "$(load_health_probe_prompt "${WORKER_CWD:-${PWD:A}}")") || return 1
    invoke_worker "$w" "$PROBE_TIMEOUT" "$of" "$ef" "${INVOKE_ARGS[@]}"; rc=$?
    out="$(<"$of")"; err="$(<"$ef")"
    record_attempt "$w" "$out" "$err" "$rc" probe
    rm -f "$of" "$ef"
    check_main_tamper || return 4

    probe_failure="$err"
    if (( rc != 0 && rc != 124 )); then
      # Only failed probes may classify bounded stdout as provider/auth failure.
      probe_out_excerpt="${out[1,8192]}"
      has_output "$probe_out_excerpt" && probe_failure+=$'\n'"$probe_out_excerpt"
    fi

    if (( rc == 0 )) && has_output "$out"; then
      mark_probe_good "$w"
      return 0
    elif (( rc == 124 )); then
      last_kind=timeout
      last_err="$err"
      print -u2 "[claude-agent] $w probe attempt $attempt/$max_attempts: timeout (${PROBE_TIMEOUT}s)"
    elif is_auth_unavailable "$probe_failure" "$rc"; then
      last_kind=auth
      last_err="$probe_failure"
      print -u2 "[claude-agent] $w probe attempt $attempt/$max_attempts: auth_unavailable"
      if restart_proxy_for_fresh_token "$w"; then
        # A fresh token must always get one post-restart probe, even when auth
        # was first recognized on the final scheduled retry.
        (( attempt >= max_attempts )) && (( ++max_attempts ))
      fi
    elif (( rc == 0 )); then
      last_kind=provider
      last_err="empty probe output"
      print -u2 "[claude-agent] $w probe attempt $attempt/$max_attempts: empty output"
    elif is_unavailable "$probe_failure" "$rc"; then
      last_kind=provider
      last_err="$probe_failure"
      print -u2 "[claude-agent] $w probe attempt $attempt/$max_attempts: provider_unavailable"
    else
      last_kind=task
      last_err="$err"
      print -u2 "[claude-agent] $w probe attempt $attempt/$max_attempts: unclassified failure (rc=$rc)"
    fi

    if (( attempt < max_attempts )); then
      delay=$(( PROBE_BACKOFF * attempt ))
      (( delay > 0 )) && sleep "$delay"
    fi
  done

  case "$last_kind" in
    timeout)
      print -u2 "[claude-agent] $w probe timeout_unavailable after $attempt attempt(s); timeout and auth are reported separately"
      return 1
      ;;
    auth)
      print -u2 "[claude-agent] $w probe auth_unavailable after $attempt attempt(s)"
      if [[ "$w" == claude-sol ]]; then
        SOL_AUTH_UNAVAILABLE=1
        print -u2 "[claude-agent] USER ACTION REQUIRED: run: cliproxyapi -codex-login"
      fi
      return 1
      ;;
    provider)
      print -u2 "[claude-agent] $w probe provider_unavailable after $attempt attempt(s)"
      return 1
      ;;
    *)
      print_task_failed "$w probe" "$last_err"
      return 4
      ;;
  esac
}

deliver() {
  local w=$1; shift
  local of ef rc err oldpwd="$PWD" wt="" wt_base=""
  of=$(mktemp); ef=$(mktemp)
  if (( isolate )); then
    prepare_worktree || { rm -f "$of" "$ef"; return 4; }
    wt="$WORKTREE_PATH"; wt_base="$WORKTREE_BASE"
    cd "$WORKER_CWD" || { rm -f "$of" "$ef"; print_task_failed "$w" "cannot enter worktree $WORKER_CWD"; return 4; }
  elif [[ -n "$repo_root" ]]; then
    capture_scope_baseline "$repo_root" || {
      rm -f "$of" "$ef"
      print_task_failed "path audit baseline" "could not snapshot the in-place worker's initial checkout"
      return 4
    }
  fi
  inject_preamble "${WORKER_CWD:-${PWD:A}}" "$@" || {
    rm -f "$of" "$ef"
    cd "$oldpwd"
    print_task_failed "$w" "visible worker preamble is unavailable"
    return 4
  }
  invoke_worker "$w" "$TASK_TIMEOUT" "$of" "$ef" "${INVOKE_ARGS[@]}"; rc=$?
  cd "$oldpwd"
  REPLY="$(<"$of")"; err="$(<"$ef")"
  record_attempt "$w" "$REPLY" "$err" "$rc" task
  rm -f "$of" "$ef"
  if ! check_main_tamper; then
    REPLY=""
    return 4
  fi
  if (( rc == 124 )); then
    TASK_TIMED_OUT=1
    : > "$RUN_DIR/timeout"
    print -u2 "[claude-agent] $w task exceeded ${TASK_TIMEOUT}s cap"
    if [[ -n "$wt" ]]; then
      salvage_timeout "$wt" "$wt_base" || {
        print_task_failed "$w timeout salvage" "could not commit and protect timed-out worktree $wt"
        REPLY=""
        return 4
      }
      report_worktree "$wt" "$wt_base"
    fi
    REPLY=""
    return 5
  fi
  if (( rc == 0 )); then
    if has_output "$REPLY"; then
      if [[ -n "$wt" ]]; then
        protect_successful_worktree "$wt" || {
          print_task_failed "$w" "could not commit and protect successful worktree $wt"
          return 4
        }
        report_worktree "$wt" "$wt_base"
      fi
      return 0
    fi
    print -u2 "[claude-agent] $w task returned empty output — retaining worktree and treating as unavailable"
    return 1
  fi
  is_unavailable "$err" "$rc" && return 1
  print_task_failed "$w" "$err"
  REPLY=""
  return 4
}

degrade_candidate=""

probe_available "$required_worker"
probe_rc=$?
(( probe_rc == 4 )) && exit 4
if (( probe_rc == 0 )); then
  deliver "$required_worker" "${task_args[@]}"
  deliver_rc=$?
  (( deliver_rc == 4 )) && exit 4
  if (( deliver_rc == 5 )); then
    print -u2 "[claude-agent] PRIMARY_UNAVAILABLE: timed-out task was salvaged; no fallback will overwrite its protected ref"
    exit 3
  fi
  if (( deliver_rc == 0 )); then
    print -u2 "[claude-agent] answered by: $required_worker (required for $role)"
    print -r -- "$REPLY"
    exit 0
  fi
  print -u2 "[claude-agent] $required_worker passed probe but hit a provider failure on the task"
else
  print -u2 "[claude-agent] $required_worker unavailable"
fi

# QUOTA FALLBACK (owner rule): if the required worker is down on quota/auth,
# Claude Opus 4.8 (claude-opus, subscription token) steps in as a SAFE
# substitute for any role — announced loudly, never silently.
if [[ "$required_worker" != "claude-opus" ]] && (( ! allow_degrade )); then
  if probe_available claude-opus; then
    print -u2 "[claude-agent] QUOTA FALLBACK: $required_worker down — claude-opus (Opus 4.8) takes the task"
    deliver claude-opus "${task_args[@]}"
    opus_rc=$?
    if (( opus_rc == 5 )); then
      print -u2 "[claude-agent] claude-opus timed out; salvaged result remains on the protected ref"
      exit 3
    fi
    if (( opus_rc == 0 )); then
      print -u2 "[claude-agent] answered by: claude-opus (quota fallback for $required_worker)"
      print -r -- "$REPLY"
      exit 0
    fi
    (( opus_rc == 4 )) && exit 4
    print -u2 "[claude-agent] claude-opus fallback also failed — continuing to degrade/refusal path"
  else
    print -u2 "[claude-agent] claude-opus fallback not available (token file? quota?)"
  fi
fi

if (( allow_degrade )); then
  for (( i=2; i <= ${#chain}; i++ )); do
    w=${chain[$i]}
    probe_available "$w"
    probe_rc=$?
    (( probe_rc == 4 )) && exit 4
    if (( probe_rc != 0 )); then
      print -u2 "[claude-agent] degraded candidate $w unavailable — skipping"
      continue
    fi
    [[ -z "$degrade_candidate" ]] && degrade_candidate="$w"
    deliver "$w" "${task_args[@]}"
    deliver_rc=$?
    (( deliver_rc == 4 )) && exit 4
    if (( deliver_rc == 5 )); then
      print -u2 "[claude-agent] degraded candidate timed out; salvaged result remains on the protected ref"
      exit 3
    fi
    if (( deliver_rc == 0 )); then
      banner="⚠️⚠️ DEGRADED FALLBACK — role=$role required=$required_worker DELIVERED=$w. This worker does not fully satisfy the requested role. Result is PROVISIONAL: re-scope/verify before trusting, and disclose the substitution to the user."
      print -r -- "$banner"
      print -r -- "----- degraded output below -----"
      print -r -- "$REPLY"
      print -u2 "$banner"
      exit 10
    fi
    print -u2 "[claude-agent] degraded candidate $w hit a provider failure — continuing"
  done
fi

print -u2 "════════════════════════════════════════════════════════════════"
print -u2 "[claude-agent] PRIMARY_UNAVAILABLE  role=$role  required=$required_worker"
if [[ "$role" == review ]]; then
  print -u2 "  Kimi is required for an independent review; there is no automatic review fallback."
  print -u2 "  defer review until Kimi is reachable, and state that deferral explicitly."
elif (( ! allow_degrade )) && (( ${#chain} > 1 )); then
  print -u2 "  Later workers in the role chain were not invoked because they do not fully satisfy '$role'."
  print -u2 "  To accept a provisional substitution explicitly: claude-agent --degrade $role ..."
elif [[ -n "$degrade_candidate" ]]; then
  print -u2 "  Every explicitly allowed degraded candidate also hit a provider failure."
else
  print -u2 "  No worker in the role chain is available."
fi
print -u2 "  ORCHESTRATOR MUST RE-PLAN — do NOT silently swap models. Options:"
print -u2 "    • decompose or re-scope the task for a later worker, then use --degrade deliberately;"
print -u2 "    • wait for the required provider's quota/auth window to recover;"
print -u2 "    • do the work yourself."
if [[ "$required_worker" == claude-sol && $SOL_AUTH_UNAVAILABLE -eq 1 ]]; then
  print -u2 "  Sol authentication remained unavailable after retry and one eligible proxy restart."
fi
print -u2 "  SURFACE this to the user if the required worker stays down across the session."
print -u2 "════════════════════════════════════════════════════════════════"
exit 3
