#!/bin/zsh
# Synchronous run observer for direct Workjet worker wrappers.
# Set WORKJET_OBSERVER_BYPASS=1 when an outer dispatcher owns the run journal.
emulate -L zsh
setopt pipe_fail

[[ $# -ge 2 ]] || { print -u2 'usage: workjet-observe WORKER COMMAND [ARG ...]'; exit 64; }
worker="$1"
shift

effective_model="${WORKJET_EFFECTIVE_MODEL:-${ANTHROPIC_MODEL:-}}"
effective_reasoning="${WORKJET_EFFECTIVE_REASONING:-${CLAUDE_CODE_EFFORT_LEVEL:-}}"
effective_speed="${WORKJET_EFFECTIVE_SPEED:-${CLAUDE_CODE_SPEED:-}}"
command_args=("$@")
for (( i=1; i <= ${#command_args}; i++ )); do
  case "${command_args[$i]}" in
    --model)
      (( i < ${#command_args} )) && effective_model="${command_args[$(( i + 1 ))]}"
      ;;
    --model=*) effective_model="${command_args[$i]#--model=}" ;;
    --effort)
      (( i < ${#command_args} )) && effective_reasoning="${command_args[$(( i + 1 ))]}"
      ;;
    --effort=*) effective_reasoning="${command_args[$i]#--effort=}" ;;
    --speed)
      (( i < ${#command_args} )) && effective_speed="${command_args[$(( i + 1 ))]}"
      ;;
    --speed=*) effective_speed="${command_args[$i]#--speed=}" ;;
    --fast) effective_speed=fast ;;
  esac
done
if [[ -z "$effective_reasoning" && "$worker" == claude-sol && "${MAX_THINKING_TOKENS:-}" == <-> ]] && (( MAX_THINKING_TOKENS >= 10000 )); then
  effective_reasoning=high
fi
if (( ${#effective_model} == 0 || ${#effective_model} > 256 )) || ! print -rn -- "$effective_model" | LC_ALL=C grep -Eq '^[][A-Za-z0-9._:/@+-]+$'; then
  effective_model=""
fi
case "$effective_reasoning" in low|medium|high|xhigh|max|ultra|ultracode|ultrathink) ;; *) effective_reasoning="" ;; esac
case "$effective_speed" in fast|normal) ;; *) effective_speed="" ;; esac

inside_dispatcher() {
  [[ "${WORKJET_OBSERVER_BYPASS:-0}" == 1 ]] && return 0
  local pid=$PPID row parent command depth=0
  while (( pid > 1 && depth < 8 )); do
    row="$(ps -p "$pid" -o ppid= -o command= 2>/dev/null)" || break
    parent="${${=row}[1]}"
    command="${row#*${${=row}[1]}}}"
    [[ "$command" == *claude-agent* ]] && return 0
    [[ "$parent" == <-> ]] || break
    pid=$parent
    (( ++depth ))
  done
  return 1
}

if [[ "${WORKJET_OBSERVER_BYPASS:-0}" == 1 ]]; then
  exec "$@"
fi

umask 077
state_root="${WORKJET_STATE_DIR:-$HOME/.local/state/workjet}"
stamp="$(date -u '+%Y%m%dT%H%M%S')"
run_id="direct-${stamp}-$$-${worker//[^A-Za-z0-9._-]/_}"
run_dir="$state_root/runs/$run_id"
index_dir="$state_root/run-index"
mkdir -p "$run_dir" "$index_dir" || { print -u2 'workjet-observe: cannot create run journal'; exit 73; }
chmod 700 "$run_dir" 2>/dev/null || true
index_tmp="$index_dir/.${run_id}.$$"
print -r -- "$run_dir" > "$index_tmp" && mv "$index_tmp" "$index_dir/$run_id" || exit 73
print -r -- "$worker" > "$run_dir/worker"
date -u '+%Y-%m-%dT%H:%M:%SZ' > "$run_dir/started-at"
print -r -- 'Direkte Claude-Code-Ausführung' > "$run_dir/activity"
touch "$run_dir/heartbeat"

write_run_state() {
  local state="$1" now sequence tmp metadata=""
  now="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  sequence="$(date -u '+%s')"
  [[ -n "$effective_model" ]] && metadata+=",\"model\":\"$effective_model\""
  [[ -n "$effective_reasoning" ]] && metadata+=",\"reasoning\":\"$effective_reasoning\""
  [[ -n "$effective_speed" ]] && metadata+=",\"speed\":\"$effective_speed\""
  tmp="$run_dir/.run-state.json.$$"
  print -r -- "{\"schemaVersion\":1,\"sequence\":$sequence,\"state\":\"$state\",\"heartbeatAt\":\"$now\"$metadata}" > "$tmp" && \
    mv "$tmp" "$run_dir/run-state.json"
}

child_pid=''
heartbeat_pid=''
forward_signal() {
  [[ -n "$child_pid" ]] && kill -TERM "$child_pid" 2>/dev/null || true
}
trap forward_signal INT TERM HUP

"$@" &
child_pid=$!
print -r -- "$child_pid" > "$run_dir/pid"
write_run_state running
(
  while kill -0 "$child_pid" 2>/dev/null; do
    sleep "${WORKJET_OBSERVER_HEARTBEAT_INTERVAL:-10}"
    if kill -0 "$child_pid" 2>/dev/null; then
      touch "$run_dir/heartbeat"
      write_run_state running
    fi
  done
) &
heartbeat_pid=$!

wait "$child_pid"
rc=$?
if kill -0 "$child_pid" 2>/dev/null; then
  wait "$child_pid"
  rc=$?
fi
kill "$heartbeat_pid" 2>/dev/null || true
wait "$heartbeat_pid" 2>/dev/null || true
print -r -- "$rc" > "$run_dir/exit-code"
{
  print -r -- "rc=$rc"
  print -r -- "finished_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
} > "$run_dir/exit"
if (( rc == 0 )); then
  write_run_state completed
else
  write_run_state failed
fi
exit "$rc"
