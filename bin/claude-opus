#!/bin/zsh
# Claude Code CLI on Opus 4.8 — the QUOTA FALLBACK worker for the fleet.
# Isolation WITHOUT --bare: --bare would also skip OAuth/keychain, killing
# subscription auth. Instead the system prompt is REPLACED outright, which
# suppresses CLAUDE.md auto-discovery (verified empirically: the orchestrator
# prompt does not leak). Auth preference:
#   1. ~/.config/secrets/claude-oauth (from `claude setup-token`) → strongest:
#      --bare + CLAUDE_CODE_OAUTH_TOKEN.
#   2. Otherwise: interactive subscription login (keychain) + system-prompt
#      isolation. Subscription billing either way — never API keys.
PROMPT_FILE="$HOME/.claude/workjet/AGENTS.md"
KEY_FILE="$HOME/.config/secrets/claude-oauth"
export ANTHROPIC_MODEL="${OPUS_MODEL:-claude-opus-4-8}"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
if [[ -f "$KEY_FILE" ]]; then
  perms=$(stat -f '%Lp' "$KEY_FILE" 2>/dev/null || stat -c '%a' "$KEY_FILE" 2>/dev/null)
  TOKEN="$(<"$KEY_FILE")"
  if [[ "$perms" == "600" && -n "$TOKEN" && "$TOKEN" != *CHANGE-ME* ]]; then
    export CLAUDE_CODE_OAUTH_TOKEN="$TOKEN"
    export CLAUDE_CONFIG_DIR="$HOME/.config/claude-opus"
    mkdir -p "$CLAUDE_CONFIG_DIR"
    exec claude --bare --model "$ANTHROPIC_MODEL" "$@"
  fi
  print -u2 "claude-opus: $KEY_FILE unbrauchbar (Rechte/Platzhalter) — nutze Keychain-Login mit System-Prompt-Isolation"
fi
# Keychain login lives in the DEFAULT config dir — do not override it here.
WORKER_PROMPT="$(sed -n '/^<!-- WORKJET OPUS SYSTEM PROMPT BEGIN -->$/,/^<!-- WORKJET OPUS SYSTEM PROMPT END -->$/p' "$PROMPT_FILE" 2>/dev/null | sed '1d;$d')"
if [[ -z "$WORKER_PROMPT" ]]; then
  print -u2 "claude-opus: sichtbarer Fallback-Systemprompt fehlt in $PROMPT_FILE"
  exit 2
fi
exec claude --model "$ANTHROPIC_MODEL" --system-prompt "$WORKER_PROMPT" "$@"
